{
  "openapi": "3.1.0",
  "info": {
    "title": "StitchHub shared API (StitchBench, StitchShop, StitchFoundry)",
    "version": "1.0.0",
    "description": "The calls StitchBench, StitchShop and StitchFoundry make to StitchHub, and the data they exchange. Describes what the hub does today. Message data is checked against the schemas named in messages.json. Licence: MIT OR Apache-2.0.",
    "license": {
      "name": "MIT OR Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://hub.stitchbench.app"
    }
  ],
  "components": {
    "securitySchemes": {
      "installKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The install key a program gets when it joins the hub. Scope `member` can call everything here; scope `partner` only /v1/partners/* and /v1/me until it upgrades."
      },
      "foundryToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Foundry Account session token (sfs_ followed by 64 hex characters), checked with the Foundry Account service."
      }
    }
  },
  "paths": {
    "/v1/shops/claim": {
      "post": {
        "summary": "A program tells the hub about one of its shops (the shop profile)",
        "security": [
          {
            "installKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "listings": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad input: the answer says what to fix"
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "409": {
            "description": "Wrong role or status for this step"
          },
          "429": {
            "description": "Rate limit"
          }
        },
        "tags": [
          "shops"
        ],
        "requestBody": {
          "required": true,
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/shop-claim.json"
              }
            }
          }
        }
      }
    },
    "/v1/partners/invites": {
      "post": {
        "summary": "Make a code to link a repair shop with a sewing shop",
        "security": [
          {
            "installKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad input: the answer says what to fix"
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "409": {
            "description": "Wrong role or status for this step"
          },
          "429": {
            "description": "Rate limit"
          }
        },
        "tags": [
          "partners"
        ],
        "requestBody": {
          "required": true,
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shopRef": {
                    "type": "string"
                  },
                  "shopName": {
                    "type": "string"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "repair",
                      "retail"
                    ]
                  },
                  "terms": {
                    "type": "object"
                  },
                  "publicKey": {
                    "type": "string"
                  },
                  "proof": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/partners/redeem": {
