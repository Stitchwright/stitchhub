{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job.reply",
  "description": "The customer's answer to the repair shop's estimate, relayed by the sewing shop (retail side).",
  "type": "object",
  "required": [
    "id",
    "approval",
    "at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "string",
      "enum": [
        "APPROVED",
        "DECLINED"
      ]
    },
    "approvedCents": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
