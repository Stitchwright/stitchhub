# PostgreSQL connection (Railway fills this in when you add a Postgres database; docker-compose sets its own)
DATABASE_URL=
# Set to "true" if your database host requires SSL without a verified certificate
DATABASE_SSL=
# Long random secret for the /admin page. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# The key members use to join (you email it to them). Can be changed later on the /admin page.
JOIN_KEY=
# Name shown to members
HUB_NAME=StitchHub
# "off" to stop the background link checker
LINK_CHECKER=
# "true" when the hub is behind a tunnel or reverse proxy (the default on Railway), so the limits on joining see each shop's own address
TRUST_PROXY=
# Largest admin upload (import, bulk load, data set) in MB; 1024 if empty
ADMIN_UPLOAD_MB=
# --- Accounts (shop owners sign in at /account; links are sent by email) ---
# The hub's own public address, for the links in its emails (on Railway the public domain is used when this is empty)
HUB_URL=
# One mailbox the hub sends from: smtps://user:pass@host:465 (or smtp://user:pass@host:587 for STARTTLS), and the From address
SMTP_URL=
MAIL_FROM=
# A test hub with no mailbox: "true" prints each email (links included) to the hub's log instead of sending it. Never on a real hub.
MAIL_DEV_LOG=
# --- Billing (Stripe subscriptions, $25 a month or $250 a year per shop; leave all four empty and nobody is charged) ---
# The Stripe secret key (sk_live_... or sk_test_...), the signing secret of the webhook endpoint https://<hub>/v1/stripe, and
# the ids of the two recurring prices made in the Stripe dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# A Stripe stand-in for a test hub (test/stripe-mock.mjs); empty = api.stripe.com
STRIPE_API_BASE=
# --- License keys for the program itself ("base") ---
# From `npm run license:keygen -- --kid hub1 --hub` in the StitchBench repo: the kid and the private key (PEM, base64).
# The matching public line must be in license-keys.ts in both programs before the hub signs. Anyone with the key can license any shop.
HUB_LICENSE_KID=
HUB_LICENSE_KEY=
