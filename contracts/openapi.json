    "/v1/partners/messages": {
      "get": {
        "summary": "Messages for this install's shops after `since`, oldest first",
        "security": [
          {
            "installKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "$ref": "./schemas/message-envelope.json"
                      }
                    },
                    "next": {
                      "type": "integer"
                    },
                    "more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad input: the answer says what to fix"
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "409": {
            "description": "Wrong role or status for this step"
          },
          "429": {
            "description": "Rate limit"
          }
        },
        "tags": [
          "partners"
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 200
            }
          }
        ]
      }
    },
    "/v1/partners/links/{id}/messages": {
      "post": {
        "summary": "Send a typed message to the partner; the same `id` twice is stored once",
        "security": [
          {
            "installKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "duplicate": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad input: the answer says what to fix"
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "409": {
            "description": "Wrong role or status for this step"
          },
          "429": {
            "description": "Rate limit"
          }
        },
        "tags": [
          "partners"
        ],
        "requestBody": {
          "required": true,
          "description": "Up to 4 MB",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "shopRef": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z]{2,20}(\\.[a-z]{2,20})?$"
                  },
                  "data": {
                    "type": "object",
                    "description": "Checked against the schema for its type (messages.json)"
                  },
                  "sig": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
